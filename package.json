{
  "name": "kindly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:watch",
    "build": "node scripts/sync-manifest.mjs && npm run build:content && vite build",
    "build:content": "esbuild src/content/content.ts --bundle --format=iife --target=chrome110 --outfile=dist/content/content.js",
    "build:watch": "node scripts/sync-manifest.mjs && concurrently -k \"vite build --watch\" \"esbuild src/content/content.ts --bundle --format=iife --target=chrome110 --outfile=dist/content/content.js --watch\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
