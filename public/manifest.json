{
  "manifest_version": 3,
  "name": "Kindly",
  "version": "0.1.0",
  "description": "AI replies that sound right, in any text box.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Kindly"
  }
}
